<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.nulkast.pulse">

    <!-- Zero INTERNET permission: NulKast Pulse is 100% local & zero-leak -->
    <permission
        android:name="io.nulkast.permission.IPC_BUS"
        android:protectionLevel="signature" />
    <uses-permission android:name="io.nulkast.permission.IPC_BUS" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <application
        android:label="@string/app_name"
        android:allowBackup="false"
        android:hardwareAccelerated="false"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".PulseMainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>
</manifest>
